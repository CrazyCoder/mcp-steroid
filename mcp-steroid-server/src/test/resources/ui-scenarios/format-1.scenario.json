{
  "scenario": 1,
  "title": "Every step, field and value of scenario format 1",
  "issue": "IDEA-000000",
  "description": "A frozen fixture: every scenario that parsed when a step or field was released must keep parsing. Add lines for new steps, fields and values; never edit or remove one.",
  "ide": "IU-262.10968.63",
  "project": "any project with src/Split.java",
  "$schema": "mcp-steroid://ide/ui-scenario-schema",
  "requires": {"since": "262.10000", "until": "262.*", "products": ["IU", "IC"], "plugins": ["com.intellij.java"], "os": ["windows", "macos", "linux"], "mode": "monolith"},
  "setup": {
    "settings": [{"registry": "ide.balloon.shadow.size", "value": "0"}, {"option": "Appearance: Show line numbers:", "value": true}],
    "menu": "merged",
    "window": {"width": 1600, "height": 1000},
    "toolwindows": {"Project": {"width": "fit"}, "Problems View": {"height": 250, "tab": "File"}, "Terminal": {"hide": true}},
    "steps": [{"action": "goto", "file": "src/Split.java", "line": 1}],
    "layout": "auto"
  },
  "steps": [
    {"action": "click", "name": "OK", "button": "left", "count": 1, "modifiers": "shift", "offset_x": 2, "offset_y": 3, "intent": "press OK"},
    {"action": "click", "ref": "e1", "button": "right"},
    {"action": "click", "text": "Setup SDK", "button": "middle", "side": "backend"},
    {"action": "click", "class": "JBList", "nth": 2, "row": "Appearance"},
    {"action": "click", "xpath": "//div[@class='JButton']", "index": 0},
    {"action": "hover", "name": "Show line numbers"},
    {"action": "type", "name": "Search", "text": "line numbers"},
    {"action": "fill", "name": "Search", "text": "numbers"},
    {"action": "press", "keys": "ENTER"},
    {"action": "check", "name": "Show line numbers"},
    {"action": "uncheck", "name": "Show line numbers"},
    {"action": "select", "name": "Settings categories", "row": "Editor"},
    {"action": "close", "title": "Settings"},
    {"action": "wait", "for": "visible", "name": "OK", "timeout_ms": 2000},
    {"action": "wait", "for": "hidden", "name": "OK"},
    {"action": "wait", "for": "enabled", "name": "OK"},
    {"action": "wait", "for": "window", "title": "Settings"},
    {"action": "wait", "for": "idle"},
    {"action": "snapshot"},
    {"action": "goto", "file": "src/Split.java", "line": 2, "column": 7},
    {"action": "goto", "file": "src/Split.java", "symbol": "x"},
    {"action": "run", "id": "ShowSettings"},
    {"action": "inspect", "name": "OK"},
    {"action": "scroll", "name": "Settings categories", "pages": 1},
    {"action": "expect", "name": "Show line numbers", "is": "visible"},
    {"action": "expect", "name": "Show line numbers", "is": "hidden", "not": true},
    {"action": "expect", "name": "OK", "is": "enabled"},
    {"action": "expect", "name": "OK", "is": "disabled", "soft": true},
    {"action": "expect", "name": "Show line numbers", "is": "checked"},
    {"action": "expect", "name": "Show line numbers", "is": "unchecked", "bug": "the option reads on after it was turned off"},
    {"action": "expect", "name": "Search", "is": "focused"},
    {"action": "expect", "name": "Search", "is": "editable"},
    {"action": "expect", "name": "Search", "value": "numbers"},
    {"action": "expect", "name": "Settings categories", "row": "Editor"},
    {"action": "expect", "name": "Settings categories", "row": "Editor", "is": "expanded"},
    {"action": "expect", "name": "Settings categories", "row": "Keymap", "is": "collapsed"},
    {"action": "expect", "name": "Settings categories", "row": "Appearance", "is": "selected"},
    {"action": "expect", "title": "Settings"},
    {"action": "expect", "file": "src/Split.java", "line": 2, "contains": "int x"},
    {"action": "expect", "file": "src/Split.java", "matches": "class \\w+"},
    {"action": "expect", "caret": "2:7", "file": "src/Split.java"},
    {"action": "expect", "notification": "Indexing", "count": 1},
    {"action": "expect", "banner": "Module JDK is not defined"},
    {"action": "expect", "error": true, "not": true},
    {"action": "settings", "page": "editor.preferences.appearance"},
    {"action": "get", "registry": "ide.balloon.shadow.size"},
    {"action": "get", "advanced": "editor.tab.painting"},
    {"action": "get", "option": "Appearance: Show line numbers:"},
    {"action": "get", "inspection": "UnusedDeclaration"},
    {"action": "get", "component": "EditorSettings", "field": "IS_WHITESPACES_SHOWN"},
    {"action": "set", "registry": "ide.balloon.shadow.size", "value": "0"},
    {"action": "set", "option": "Appearance: Show line numbers:", "value": false},
    {"action": "toolwindow", "id": "Project", "tab": "Project"},
    {"action": "toolwindow", "id": "Project", "hide": true},
    {"action": "write", "file": "src/Split.java", "text": "class Split {\n  int x;\n}\n"},
    {"action": "perf", "command": "%delayType 50"},
    {"action": "code", "code": "println(project.name)"},
    {"action": "code", "code": "println(1)", "modal": "smart_non_modal"},
    {"action": "code", "code": "println(2)", "modal": "non_modal"},
    {"action": "code", "code": "println(3)", "modal": "unleashed"},
    {"action": "code", "code": "println(4)", "modal": "dialog"},
    {"action": "screenshot", "save": "settings-page", "side": "frontend"},
    {"action": "screenshot", "out": "pictures/appearance.png", "highlight": ["breadcrumb", {"name": "Show line numbers", "label": "Turn this on"}, {"name": "Settings categories", "row": "Editor"}], "crop": "page", "margin": 8},
    {"action": "screenshot", "save": "tree", "crop": {"name": "Settings categories"}},
    {"action": "screenshot", "out": "pictures/v1.2/tree"},
    {"action": "screenshot", "out": "pictures/tree.JPG"},
    {"action": "screenshot", "save": "marked", "highlight": [{"text": "Apply", "index": 0}], "crop": "highlights"},
    {"action": "scroll", "name": "Show line numbers", "align": "top"},
    {"action": "menu", "path": "View > Appearance", "show": true},
    {"action": "screenshot", "out": "pictures/view-menu.png", "crop": "popups"},
    {"action": "set", "theme": "Light"},
    {"action": "get", "themes": true},
    {"action": "get", "layout": true, "within": "100,200,300,24"},
    {"action": "window", "dimension": "SettingsEditor", "width": 1400, "height": 900},
    {"action": "splitter", "class": "XDebuggerTree", "size": "fit"},
    {"action": "splitter", "class": "OnePixelSplitter", "proportion": 0.3},
    {"action": "splitter", "key": "ProjectStructure.proportion", "proportion": 0.25},
    {"action": "click", "class": "EditorComponentImpl", "button": "right", "symbol": "parse"},
    {"action": "screenshot", "out": "pictures/code.png", "highlight": [{"lines": "20-27", "file": "src/a.ts"}, {"symbol": "parse", "nth": 1}, {"click": true, "label": "right-click"}], "crop": "highlights"},
    {"action": "screenshot", "out": "pictures/inspection.png", "highlight": [{"inspection": "NullableProblems"}], "fit": true},
    {"action": "screenshot", "out": "pictures/outlined.png", "highlight": ["breadcrumb", {"name": "Show line numbers"}], "numbers": false},
    {"action": "screenshot", "out": "pictures/run.png", "highlight": [{"console": "App", "contains": "error"}], "crop": {"toolwindow": "Run"}},
    {"action": "fill", "class": "TreeTable", "row": "Hard wrap at:", "text": "90"},
    {"action": "expect", "class": "TreeTable", "row": "Hard wrap at:", "value": "90"},
    {"action": "expect", "class": "TreeTable", "row": "Hard wrap at:", "contains": "9"},
    {"action": "expect", "error": "", "not": true},
    {"action": "get", "editors": true},
    {"action": "get", "memory": true},
    {"action": "expect", "memory": "heap_after_gc", "below": 4096},
    {"action": "get", "builds": true},
    {"action": "get", "notifications": true},
    {"action": "get", "problems": "src/A.kt", "severity": "warning"},
    {"action": "get", "changes": true},
    {"action": "get", "console": "App", "lines": 20},
    {"action": "expect", "console": "App", "contains": "total: 5"},
    {"action": "expect", "changed": ["src/App.java"]},
    {"action": "expect", "diff": "-int total = count;\n+int total = computeTotal();"},
    {"action": "expect", "file": "src/App.java", "golden": "expected/App.java"},
    {"action": "get", "file": "src/Split.java"},
    {"action": "get", "log": "#com.jetbrains.rdserver.fileEditors"},
    {"action": "set", "log": "#com.jetbrains.rdserver.fileEditors", "value": "trace"},
    {"action": "expect", "editor": "src/Split.java"},
    {"action": "expect", "editor": "Split.java", "is": "focused"},
    {"action": "expect", "editor": "docs/headings.md", "is": "hidden"},
    {"action": "expect", "log": "Opening remote editor for file=page.xml", "side": "backend"},
    {"action": "toolwindow", "id": "Project", "width": "fit"},
    {"action": "toolwindow", "id": "Problems View", "height": 300},
    {"action": "window", "width": 1800, "height": 1200},
    {"action": "window", "title": "Settings", "width": "fit"},
    {"action": "window", "maximize": true},
    {"action": "window", "maximize": false},
    {"action": "window"},
    {"action": "expect", "layout": true},
    {"action": "expect", "layout": true, "name": "Project Tool Window"},
    {"action": "menu"},
    {"action": "menu", "path": "View > Appearance"},
    {"action": "menu", "path": "View > Appearance > Status Bar"},
    {"action": "menu", "mode": "hamburger"},
    {"action": "menu", "mode": "merged"},
    {"action": "menu", "mode": "toolbar"},
    {"action": "check", "path": "View > Appearance > Status Bar"},
    {"action": "uncheck", "path": "View > Appearance > Status Bar"},
    {"action": "write", "file": "src/Split.java", "delete": true},
    {"action": "toolwindow", "id": "Project", "hide": false},
    {"action": "window", "class": "IdeFrameImpl", "maximize": true}
  ],
  "cleanup": [
    {"action": "close"},
    {"action": "set", "option": "Appearance: Show line numbers:", "value": true}
  ]
}
